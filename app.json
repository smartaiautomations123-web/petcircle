{
  "expo": {
    "name": "PetCircle",
    "slug": "petcircle",
    "scheme": "petcircle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "owner": "smartaiautomations",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petcirclecare.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow PetCircle to choose a photo for your pet profile or lost pet poster.",
        "NSCameraUsageDescription": "Allow PetCircle to take photos of your pet for their profile or lost pet poster."
      }
    },
    "android": {
      "package": "com.petcirclecare.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#143D31",
        "foregroundImage": "./assets/adaptive.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "PetCircle",
      "shortName": "PetCircle",
      "themeColor": "#143D31"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PetCircle to choose a photo for your pet.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "53980c87-e05e-46e4-9594-78c477197641"
      }
    }
  }
}
